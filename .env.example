# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
APP_URL="MY_APP_URL"

# VOICE_ENGINE_URL: Optional URL of your self-hosted Python FastAPI AI Voice Worker (e.g. XTTS-v2, Fish-Speech, F5-TTS, CosyVoice)
VOICE_ENGINE_URL=""

# VOICE_ENGINE_API_KEY: Shared secret header sent from VoiceLab backend to your self-hosted GPU worker
VOICE_ENGINE_API_KEY=""

# EXTERNAL_TTS_ENDPOINT: Optional external REST TTS/Cloning adapter endpoint
EXTERNAL_TTS_ENDPOINT=""
EXTERNAL_TTS_API_KEY=""

# MAX_AUDIO_UPLOAD_MB: Maximum voice sample upload size in MB (default 25)
MAX_AUDIO_UPLOAD_MB="25"

# TEMP_FILE_RETENTION_HOURS: Automatic cleanup age for temporary uploaded artifacts
TEMP_FILE_RETENTION_HOURS="24"
